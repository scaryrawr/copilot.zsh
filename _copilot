        '--no-remote-export[Disable exporting your session to GitHub web and mobile]'
        '--output-format[Set the output format]:format:(text json)'
        '--plain-diff[Disable rich diff rendering]'
        '--plan[Start in plan mode]'
        '(-p --prompt)'{-p,--prompt}'[Execute a prompt in non-interactive mode]:prompt'
        '*--plugin-dir[Load a plugin from a local directory]:directory:_directories'
        '--remote[Enable remote control of your session from GitHub web and mobile]'
        '--remote-export[Export your session to GitHub web and mobile]'
        '(--effort --reasoning-effort)--reasoning-effort[Set the reasoning effort level]:level:->reasoning_efforts'
