        'mcp:Manage MCP servers'
        'plugin:Manage plugins'
        'plugins:Inspect configured plugins across kinds'
        'skill:Manage skills'
        'update:Download the latest version'
        'version:Display version information'
    )

    help_topics=(
        'billing:AI credit usage'
        'commands:Interactive Mode Commands'
        'config:Configuration Settings'
        'environment:Environment Variables'
        'limits:Session Limits Controls'
        'logging:Logging'
        'monitoring:Monitoring with OpenTelemetry'
        'permissions:Permissions'
        'providers:Custom Model Providers (BYOK)'
        'sandbox:Command Sandboxing'
    )

    agent_modes=(
        'interactive:Start in interactive mode'
        'plan:Start in plan mode'
        'autopilot:Start in autopilot mode'
    )

    log_levels=(
        'none:No logging'
        'error:Error level'
        'warning:Warning level'
        'info:Info level'
        'debug:Debug level'
        'all:All levels'
        'default:Default level'
    )

    # Fallback list; prefer dynamic extraction from `copilot --help` at completion time.
    models=(
        'auto:Let Copilot pick automatically'
        'claude-sonnet-5:Claude Sonnet 5'
        'claude-fable-5:Claude Fable 5'
        'claude-opus-5:Claude Opus 5'
        'claude-opus-4.8:Claude Opus 4.8'
        'claude-opus-4.8-fast:Claude Opus 4.8 (fast mode)'
        'claude-opus-4.7:Claude Opus 4.7'
        'claude-sonnet-4.6:Claude Sonnet 4.6'
        'claude-opus-4.6:Claude Opus 4.6'
        'claude-sonnet-4.5:Claude Sonnet 4.5'
        'claude-opus-4.5:Claude Opus 4.5'
        'claude-haiku-4.5:Claude Haiku 4.5'
        'gpt-5.6-sol:GPT-5.6 Sol'
        'gpt-5.6-terra:GPT-5.6 Terra'
        'gpt-5.6-luna:GPT-5.6 Luna'
        'gpt-5.5:GPT-5.5'
        'gpt-5.4:GPT-5.4'
        'gpt-5.4-mini:GPT-5.4 Mini'
        'gpt-5.3-codex:GPT-5.3 Codex'
        'gpt-5-mini:GPT-5 Mini'
        'mai-code-1.1-flash:MAI Code 1.1 Flash'
        'mai-code-1-flash-picker:MAI Code 1 Flash'
        'gemini-3.7-flash:Gemini 3.7 Flash'
        'gemini-3.6-flash:Gemini 3.6 Flash'
        'gemini-3.5-flash:Gemini 3.5 Flash'
        'gemini-3.1-pro-preview:Gemini 3.1 Pro Preview'
        'grok-4.5:Grok 4.5'
        'kimi-k3:Kimi K3'
        'kimi-k2.7-code:Kimi K2.7 Code'
    )

    reasoning_efforts=(
        'none:No reasoning effort'
        'minimal:Minimal reasoning effort'
        'low:Low reasoning effort'
        'medium:Medium reasoning effort'
        'high:High reasoning effort'
        'xhigh:Extra high reasoning effort'
        'max:Maximum reasoning effort'
    )

    stream_modes=(
        'on:Enable streaming'
        'off:Disable streaming'
    )

    local -a command_options completion_shells login_options mcp_add_options mcp_command_options mcp_commands
    local -a mcp_get_options mcp_list_options mcp_options plugin_command_options
    local -a plugin_commands plugin_marketplace_commands plugin_options plugins_commands
    local -a plugins_install_options plugins_list_options plugins_marketplace_commands
    local -a plugins_target_options skill_commands

    command_options=(
        '(-h --help)'{-h,--help}'[Display help for command]'
    )

    completion_shells=(
        'bash:Bash completion script'
        'zsh:Zsh completion script'
        'fish:Fish completion script'
    )

    mcp_commands=(
        'add:Add an MCP server'
        'get:Show server details'
        'list:List configured MCP servers'
        'remove:Remove an MCP server'
    )

    mcp_options=(
        '(-h --help)'{-h,--help}'[Display help for command]'
    )

    mcp_command_options=(
        '(-h --help)'{-h,--help}'[Display help for command]'
    )

    mcp_add_options=(
        $mcp_command_options
        '*--env[Environment variable]:env'
        '*--header[HTTP header for remote servers]:header'
        '--json[Output added config as JSON]'
        '--show-secrets[Show full environment variable and header values in output]'
        '--timeout[Timeout in milliseconds]:ms'
        '--tools[Tool filter]:tools'
        '--transport[Server transport]:transport:(stdio http sse)'
    )

    mcp_get_options=(
        $mcp_command_options
        '--json[Output as JSON]'
        '--show-secrets[Show full environment variable and header values]'
    )

    mcp_list_options=(
        $mcp_command_options
        '--json[Output as JSON]'
    )

    plugin_commands=(
        'install:Install a plugin'
        'list:List installed plugins'
        'marketplace:Manage plugin marketplaces'
        'uninstall:Uninstall a plugin'
        'update:Update a plugin to the latest version'
    )

    plugin_marketplace_commands=(
        'add:Add a marketplace'
        'browse:Browse plugins in a marketplace'
        'list:List registered marketplaces'
        'remove:Remove a marketplace'
        'update:Update marketplace plugin catalogs'
    )

    login_options=(
        '(--device-code --web-flow --with-token)--device-code[Authenticate using the OAuth device code flow]'
        '(-h --help)'{-h,--help}'[Display help for command]'
        '--host[GitHub host URL]:host'
        '(--device-code --web-flow --with-token)--web-flow[Authenticate using the browser flow]'
        '(--device-code --web-flow --with-token)--with-token[Read an authentication token from standard input]'
    )

    plugin_options=(
        '(-h --help)'{-h,--help}'[Display help for command]'
    )

    plugin_command_options=(
        '(-h --help)'{-h,--help}'[Display help for command]'
    )

    plugins_commands=(
        'add:Install a new tool'
        'disable:Disable a configured tool'
        'enable:Enable a configured tool'
        'install:Install a new tool'
        'list:List configured plugins across kinds'
        'marketplace:Manage plugin marketplaces'
        'marketplaces:Manage plugin marketplaces'
        'remove:Remove an installed tool'
        'rm:Remove an installed tool'
        'update:Update a plugin'
    )

    plugins_target_options=(
        '(--mcp --plugin --skill)--mcp[Target an MCP server]'
        '(--mcp --plugin --skill)--plugin[Target a plugin]'
        '(--mcp --plugin --skill)--skill[Target a skill]'
        '(-h --help)'{-h,--help}'[Display help for command]'
    )

    plugins_install_options=(
        $plugins_target_options
        '--scope[Install target for a skill]:scope:(user project)'
    )

    plugins_list_options=(
        '(-h --help)'{-h,--help}'[Display help for command]'
        '--json[Emit machine-readable JSON]'
        '*--kind[Filter by kind]:kind:(plugin mcp skill instruction lsp)'
        '*--scope[Filter by scope]:scope:(user repository working-directory organization plugin builtin unknown)'
    )

    plugins_marketplace_commands=(
        'add:Add a plugin marketplace'
        'browse:Browse plugins in a marketplace'
        'list:List registered plugin marketplaces'
        'ls:List registered plugin marketplaces'
        'refresh:Refresh marketplace plugin catalogs'
        'remove:Remove a plugin marketplace'
        'rm:Remove a plugin marketplace'
        'update:Refresh marketplace plugin catalogs'
    )

    skill_commands=(
        'add:Add a skill'
        'list:List available skills'
        'remove:Remove a skill or custom skill directory'
    )

    _arguments -C \
        $options \
        '1: :->cmds' \
        '*::arg:->args'

    case $state in
        cmds)
            _describe -t commands 'copilot commands' commands
            ;;
        args)
            case $words[1] in
                help)
                    if [[ $words[2] == -* ]]; then
                        _arguments $command_options
                    else
                        _describe -t help-topics 'help topics' help_topics
                    fi
                    ;;
                app)
                    _arguments $command_options
                    ;;
                completion)
                    _arguments $command_options ':shell:->completion_shells'
                    case $state in
                        completion_shells)
                            _describe -t shells 'shells' completion_shells
                            ;;
                    esac
                    ;;
                init)
                    _arguments $command_options
                    ;;
                login)
                    _arguments $login_options
                    ;;
                mcp)
                    case $words[2] in
                        -*)
                            _arguments $mcp_options
                            ;;
                        add)
                            _arguments $mcp_add_options ':name:' '*::url-or-command-and-args:'
                            ;;
                        get)
                            _arguments $mcp_get_options ':name:'
                            ;;
                        list)
                            _arguments $mcp_list_options
                            ;;
                        remove)
                            _arguments $mcp_command_options ':name:'
                            ;;
                        *)
                            _describe -t mcp-commands 'mcp commands' mcp_commands
                            ;;
                    esac
                    ;;
                plugin)
                    case $words[2] in
                        -*)
                            _arguments $plugin_options
                            ;;
                        install)
                            _arguments $plugin_command_options ':source:_copilot__complete_installable_plugins'
                            ;;
                        uninstall)
                            _arguments $plugin_command_options ':name:_copilot__complete_installed_plugins'
                            ;;
                        update)
                            _arguments \
                                '--all[Update all installed plugins]' \
                                $plugin_command_options \
                                '::name:_copilot__complete_installed_plugins'
                            ;;
                        list)
                            _arguments $plugin_command_options
                            ;;
                        marketplace)
                            case $words[3] in
                                -*)
                                    _arguments $plugin_options
                                    ;;
                                add)
                                    _arguments $plugin_command_options ':source:'
                                    ;;
                                remove)
                                    _arguments \
                                        '(-f --force)'{-f,--force}'[Force removal even if plugins are installed]' \
                                        $plugin_command_options \
                                        ':name:_copilot__complete_marketplaces'
                                    ;;
                                list)
                                    _arguments $plugin_command_options
                                    ;;
                                browse)
                                    _arguments $plugin_command_options ':name:_copilot__complete_marketplaces'
                                    ;;
                                update)
                                    _arguments $plugin_command_options '::name:_copilot__complete_marketplaces'
                                    ;;
                                *)
                                    _describe -t plugin-marketplace-commands 'plugin marketplace commands' plugin_marketplace_commands
                                    ;;
                            esac
                            ;;
                        *)
                            _describe -t plugin-commands 'plugin commands' plugin_commands
                            ;;
                    esac
                    ;;
                plugins)
                    case $words[2] in
                        -*)
                            _arguments $command_options
                            ;;
                        add|install)
                            _arguments $plugins_install_options ':spec:_files'
                            ;;
                        disable|enable|remove|rm)
                            _arguments $plugins_target_options ':name:'
                            ;;
                        list)
                            _arguments $plugins_list_options
                            ;;
                        update)
                            _arguments \
                                '--all[Update all installed plugins]' \
                                $command_options \
                                '::name:_copilot__complete_installed_plugins'
                            ;;
                        marketplace|marketplaces)
                            case $words[3] in
                                -*)
                                    _arguments $command_options
                                    ;;
                                add)
                                    _arguments $command_options ':source:_files'
                                    ;;
                                browse)
                                    _arguments \
                                        '--json[Emit machine-readable JSON]' \
                                        $command_options \
                                        ':name:_copilot__complete_marketplaces'
                                    ;;
                                list|ls)
                                    _arguments '--json[Emit machine-readable JSON]' $command_options
                                    ;;
                                remove|rm)
                                    _arguments \
                                        '--force[Also uninstall plugins from this marketplace]' \
                                        $command_options \
                                        ':name:_copilot__complete_marketplaces'
                                    ;;
                                update|refresh)
                                    _arguments $command_options '::name:_copilot__complete_marketplaces'
                                    ;;
                                *)
                                    _describe -t plugins-marketplace-commands 'plugins marketplace commands' plugins_marketplace_commands
                                    ;;
                            esac
                            ;;
                        *)
                            _describe -t plugins-commands 'plugins commands' plugins_commands
                            ;;
                    esac
                    ;;
                skill)
                    case $words[2] in
                        -*)
                            _arguments $command_options
                            ;;
                        add)
                            _arguments \
                                '--project[Install the skill into the project]' \
                                $command_options \
                                ':source:_files'
                            ;;
                        list)
                            _arguments '--json[Output as JSON]' $command_options
                            ;;
                        remove)
                            _arguments $command_options ':name-or-directory:_files'
                            ;;
                        *)
                            _describe -t skill-commands 'skill commands' skill_commands
                            ;;
                    esac
                    ;;
                update)
                    _arguments $command_options ':channel:(stable prerelease)'
                    ;;
                version)
                    _arguments $command_options
                    ;;
            esac
            ;;
        agent_modes)
            _describe -t agent-modes 'agent modes' agent_modes
            ;;
        log_levels)
            _describe -t log-levels 'log levels' log_levels
            ;;
        models)
            local -a dyn_models
            dyn_models=("${(@f)$(_copilot__models_from_help)}")
            if (( ${#dyn_models} )); then
                dyn_models=('auto:Let Copilot pick automatically' $dyn_models)
                _describe -t models 'AI models' dyn_models
            else
                _describe -t models 'AI models' models
            fi
            ;;
        reasoning_efforts)
            _describe -t reasoning-efforts 'reasoning effort levels' reasoning_efforts
            ;;
        stream_modes)
            _describe -t stream-modes 'streaming modes' stream_modes
            ;;
    esac
}

# Only execute in completion context.
if (( $+compstate )); then
    _copilot "$@"
fi
